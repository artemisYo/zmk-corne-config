#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  ,  |  .  |  P  |   Y  |  /  |   | BSPC |  F  |  G  |  C  |  R  | L |
// |   A  |  O  |  E  |  U  |   I  |  ;  |   |   '  |  D  |  H  |  T  |  N  | S |
// | CTRL |  Q  |  J  |  K  |   X  |  [  |   |   ]  |  B  |  M  |  W  |  V  | Z |
//                    | NUM | SHFT | SPC |   |  RET | ALT | GUI |
//                      bindings = <
// &kp ESC   &kp COMMA &kp DOT &kp P &kp Y     &kp FSLH    &kp BSPC &kp F    &kp G    &kp C &kp R &kp L
// &kp A     &kp O     &kp E   &kp U &kp I     &kp SEMI    &kp SQT  &kp D    &kp H    &kp T &kp N &kp S
// &sk LCTRL &kp Q     &kp J   &kp K &kp X     &kp LBKT    &kp RBKT &kp B    &kp M    &kp W &kp V &kp Z
//                             &sl 1 &sk LSHFT &kp SPACE   &kp RET  &sk LALT &sk LGUI
//                      >;
// -----------------------------------------------------------------------------------------
// |  ESC |  /  |  ,  |  .  |  P  |   Y  |   |  F  |  G  |  C  |  R  | L | BSPC |
// |   ;  |  A  |  O  |  E  |  U  |   I  |   |  D  |  H  |  T  |  N  | S |   '  |
// | CTRL |  [  |  Q  |  J  |  K  |   X  |   |  B  |  M  |  W  |  V  | Z |   ]  |
//                    | GUI | SHFT | SPC |   | RET | ALT | NUM |
                        bindings = <
   &kp ESC   &kp FSLH &kp COMMA &kp DOT  &kp P     &kp Y        &kp F    &kp G    &kp C &kp R &kp L &kp BSPC
   &kp SEMI  &kp A    &kp O     &kp E    &kp U     &kp I        &kp D    &kp H    &kp T &kp N &kp S &kp SQT
   &sk LCTRL &kp LBKT &kp Q     &kp J    &kp K     &kp X        &kp B    &kp M    &kp W &kp V &kp Z &kp RBKT
                                &sk LGUI &sk LSHFT &kp SPACE    &kp RET  &sk LALT &sl 1
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  1  |  2  |  3  |  4  |  5  |  \  |   | BSPC |  6  |  7  |  8  | 9 | 0 |
// | TAB |     |  (  | UP  |  )  |  -  |   |  `   | RGB | BRI | BRD |   |   |
// |     |     | LFT | DWN | RGT |  =  |   |      | CLR | NXT |     |   |   |
//                   |     |     |     |   | SHFT |     |     |
//                      bindings = <
// &kp N1  &kp N2 &kp N3    &kp N4   &kp N5    &kp BSLH       &kp BSPC  &kp N6          &kp N7          &kp N8          &kp N9 &kp N0
// &kp TAB &trans &kp LPAR  &kp UP   &kp RPAR  &kp MINUS      &kp GRAVE &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &trans
// &trans  &trans &kp LEFT  &kp DOWN &kp RIGHT &kp EQUAL      &trans    &bt BT_CLR      &bt BT_NXT      &trans          &trans &trans
//                          &trans   &trans    &trans         &sk LSHFT &trans          &trans
//                      >;
// -----------------------------------------------------------------------------------------
// |     |  1  |  2  |  3  |  4  |  5  |   | 6 |  7  |  8  |  9  | 0 |   |
// | TAB |     |  (  | UP  |  )  |  -  |   | ` | RGB | BRI | BRD |   |   |
// |     |     | LFT | DWN | RGT |  =  |   | \ | CLR | NXT |     |   |   |
//                   |     |     |     |   |   |     |     |
                        bindings = <
   &trans  &kp N1 &kp N2    &kp N3   &kp N4    &kp N5         &kp N6    &kp N7          &kp N8          &kp N9          &kp N0 &trans
   &kp TAB &trans &kp LPAR  &kp UP   &kp RPAR  &kp MINUS      &kp GRAVE &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &trans
   &trans  &trans &kp LEFT  &kp DOWN &kp RIGHT &kp EQUAL      &kp BSLH  &bt BT_CLR      &bt BT_NXT      &trans          &trans &trans
                            &trans   &trans    &trans         &trans    &trans          &trans
                        >;
                };

//              raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
//                      bindings = <
//   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
//   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
//   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
//                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
//                        >;
//                };
        };
};
